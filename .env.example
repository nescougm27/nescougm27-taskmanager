# Copy to .env.local. Use DEMO_MODE=false for your real committee workspace.
# With no credentials, the application opens a clearly labelled, in-memory demo.
DEMO_MODE=true
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Google OAuth web application credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Sheets API v4 — server-only. Never prefix these with NEXT_PUBLIC_.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Used only by the initialization script to bootstrap the first admin.
# This must be an actual verified Google account email, not a domain.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
